generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  username              String                @unique
  role                  String                @default("USER")
  isSuspended           Boolean               @default(false)
  suspendedReason       String?
  passwordHash          String
  avatarUrl             String?
  bannerUrl             String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  videos                Video[]
  shorts                ShortVideo[]
  comments              Comment[]
  likes                 Like[]
  subscriptions         Subscription[]        @relation("subscriber")
  subscribers           Subscription[]        @relation("channel")
  views                 View[]
  watchSessions         WatchSession[]
  adImpressions         AdImpression[]
  revenueLedgerRows     RevenueLedger[]
  socialPosts           SocialPost[]
  socialStories         SocialStory[]
  socialLikes           SocialLike[]
  socialComments        SocialComment[]
  following             SocialFollow[]        @relation("following")
  followers             SocialFollow[]        @relation("followers")
  postMentions          SocialPostMention[]
  storyMentions         SocialStoryMention[]
  chatParticipants      ChatParticipant[]
  sentMessages          ChatMessage[]             @relation("senderMessages")
  messageReads          ChatReadReceipt[]
  messageReactions      ChatReaction[]
  presenceEvents        UserPresence[]
  initiatedCalls        CallLog[]              @relation("initiatedCalls")
  receivedCalls         CallLog[]              @relation("receivedCalls")
  cryptoKey            UserCryptoKey?
  chatKeyEnvelopes     ChatKeyEnvelope[]
  monetizationConfigs  MonetizationConfig[]  @relation("monetizationUpdatedBy")
  moderationActions     ModerationAction[]    @relation("moderatedBy")
  reportsCreated        ModerationReport[]    @relation("reporter")
  reportsReceived       ModerationReport[]    @relation("reportedUser")
  assistantMemories     AssistantMemory[]
  assistantMessages     AssistantMessage[]

  @@index([createdAt])
  @@index([role])
  @@index([isSuspended])
}

model Video {
  id             String        @id @default(cuid())
  title          String
  description    String?
  videoUrl       String
  thumbnailUrl   String?
  durationSec    Int?
  visibility     String        @default("PUBLIC")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  comments       Comment[]
  likes          Like[]
  views          View[]
  watchSessions  WatchSession[]
  trendingScores TrendingScore[]
  revenueLedger  RevenueLedger[]

  @@index([ownerId, createdAt])
  @@index([title])
}

model ShortVideo {
  id               String           @id @default(cuid())
  title            String
  caption          String?
  videoUrl         String
  thumbnailUrl     String?
  durationSec      Int
  aspectRatio      String           @default("9:16")
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  watchSessions    WatchSession[]
  trendingScores   TrendingScore[]
  adImpressions    AdImpression[]
  revenueLedger    RevenueLedger[]

  @@index([ownerId, createdAt])
  @@index([createdAt])
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  videoId     String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([userId])
}

model Like {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String
  videoId     String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

model Subscription {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  subscriberId String
  channelId    String
  subscriber   User     @relation("subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  channel      User     @relation("channel", fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, channelId])
  @@index([channelId])
}

model View {
  id          String   @id @default(cuid())
  watchedAt   DateTime @default(now())
  watchMs     Int?
  userId      String?
  videoId     String
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, watchedAt])
  @@index([userId])
}

model WatchSession {
  id             String      @id @default(cuid())
  userId         String?
  videoId        String?
  shortVideoId   String?
  watchedMs      Int         @default(0)
  completionRate Float       @default(0)
  createdAt      DateTime    @default(now())
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  video          Video?      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  shortVideo     ShortVideo? @relation(fields: [shortVideoId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([videoId, createdAt])
  @@index([shortVideoId, createdAt])
}

model TrendingScore {
  id             String      @id @default(cuid())
  calculatedAt   DateTime    @default(now())
  score          Float
  windowMinutes  Int         @default(1440)
  videoId        String?
  shortVideoId   String?
  video          Video?      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  shortVideo     ShortVideo? @relation(fields: [shortVideoId], references: [id], onDelete: Cascade)

  @@index([score, calculatedAt])
  @@index([videoId])
  @@index([shortVideoId])
}

model Advertisement {
  id                String         @id @default(cuid())
  name              String
  mediaUrl          String
  clickUrl          String?
  durationSec       Int            @default(60)
  intervalMin       Int            @default(15)
  placement         String         @default("UNIVERSAL")
  contentRating     String         @default("GENERAL")
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  adImpressions     AdImpression[]
  revenueLedgerRows RevenueLedger[]

  @@index([isActive, placement, createdAt])
}

model AdImpression {
  id             String         @id @default(cuid())
  adId           String
  userId         String?
  shortVideoId   String?
  shownAt        DateTime       @default(now())
  watchMs        Int            @default(0)
  ad             Advertisement  @relation(fields: [adId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  shortVideo     ShortVideo?    @relation(fields: [shortVideoId], references: [id], onDelete: SetNull)

  @@index([adId, shownAt])
  @@index([userId, shownAt])
  @@index([shortVideoId, shownAt])
}

model RevenueLedger {
  id               String         @id @default(cuid())
  sourceType       String
  sourceId         String
  grossRevenueUsd  Decimal        @db.Decimal(10, 2)
  creatorSharePct  Float          @default(40)
  creatorShareUsd  Decimal        @db.Decimal(10, 2)
  platformShareUsd Decimal        @db.Decimal(10, 2)
  ownerUserId      String?
  videoId          String?
  shortVideoId     String?
  adId             String?
  createdAt        DateTime       @default(now())
  ownerUser        User?          @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  video            Video?         @relation(fields: [videoId], references: [id], onDelete: SetNull)
  shortVideo       ShortVideo?    @relation(fields: [shortVideoId], references: [id], onDelete: SetNull)
  ad               Advertisement? @relation(fields: [adId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt])
  @@index([sourceType, createdAt])
}

model MonetizationConfig {
  id                     String   @id @default(cuid())
  creatorSharePct        Float    @default(40)
  minimumPayoutUsd       Decimal  @default(50) @db.Decimal(10, 2)
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  updatedBy              User?    @relation("monetizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}


model ModerationReport {
  id               String    @id @default(cuid())
  reportType       String
  targetType       String
  targetId         String
  reason           String
  status           String    @default("OPEN")
  reporterId       String?
  reportedUserId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  reporter         User?     @relation("reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser     User?     @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  actions          ModerationAction[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationAction {
  id               String    @id @default(cuid())
  reportId         String
  moderatorId      String
  actionType       String
  note             String?
  createdAt        DateTime  @default(now())
  report           ModerationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  moderator        User      @relation("moderatedBy", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([moderatorId, createdAt])
  @@index([reportId, createdAt])
}

model SocialPost {
  id           String            @id @default(cuid())
  authorId     String
  content      String?
  postType     String            @default("TEXT")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media        SocialPostMedia[]
  hashtags     SocialPostHashtag[]
  mentions     SocialPostMention[]
  likes        SocialLike[]
  comments     SocialComment[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model SocialPostMedia {
  id         String     @id @default(cuid())
  postId      String
  mediaUrl    String
  mediaType   String    @default("IMAGE")
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  post        SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
}

model SocialStory {
  id         String              @id @default(cuid())
  authorId    String
  content     String?
  mediaUrl    String?
  mediaType   String             @default("TEXT")
  createdAt   DateTime           @default(now())
  expiresAt   DateTime
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions    SocialStoryMention[]
  likes       SocialStoryLike[]

  @@index([authorId, createdAt])
  @@index([expiresAt])
}

model SocialLike {
  id         String      @id @default(cuid())
  postId      String
  userId      String
  createdAt   DateTime   @default(now())
  post        SocialPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model SocialStoryLike {
  id         String       @id @default(cuid())
  storyId      String
  userId       String
  createdAt    DateTime   @default(now())
  story        SocialStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId, createdAt])
}

model SocialComment {
  id          String      @id @default(cuid())
  postId       String
  userId       String
  content      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  post         SocialPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model SocialFollow {
  id           String    @id @default(cuid())
  followerId   String
  followingId  String
  status       String    @default("FOLLOWING")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  follower     User      @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following    User      @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model Hashtag {
  id          String              @id @default(cuid())
  tag         String              @unique
  createdAt   DateTime            @default(now())
  posts       SocialPostHashtag[]

  @@index([createdAt])
}

model SocialPostHashtag {
  id          String      @id @default(cuid())
  postId       String
  hashtagId    String
  createdAt    DateTime   @default(now())
  post         SocialPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag      Hashtag     @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
  @@index([hashtagId, createdAt])
}

model SocialPostMention {
  id          String      @id @default(cuid())
  postId       String
  mentionedUserId String
  createdAt    DateTime   @default(now())
  post         SocialPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  mentionedUser User       @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, mentionedUserId])
  @@index([mentionedUserId, createdAt])
}

model SocialStoryMention {
  id             String      @id @default(cuid())
  storyId         String
  mentionedUserId String
  createdAt       DateTime   @default(now())
  story           SocialStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  mentionedUser   User        @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([storyId, mentionedUserId])
  @@index([mentionedUserId, createdAt])
}


model Chat {
  id             String            @id @default(cuid())
  type           String            @default("DIRECT")
  title          String?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants   ChatParticipant[]
  messages       ChatMessage[]
  callLogs       CallLog[]
  keyEnvelopes   ChatKeyEnvelope[]

  @@index([type, createdAt])
  @@index([createdById])
}

model ChatParticipant {
  id             String      @id @default(cuid())
  chatId         String
  userId         String
  role           String      @default("MEMBER")
  joinedAt       DateTime    @default(now())
  lastReadAt     DateTime?
  chat           Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, joinedAt])
}

model ChatMessage {
  id                String              @id @default(cuid())
  chatId            String
  senderId          String
  messageType       String              @default("TEXT")
  text              String?
  mediaUrl          String?
  voiceDurationSec  Int?
  encryptedPayload  String?
  encryptionIv      String?
  encryptionAlg     String?
  encryptionVersion Int        @default(1)
  createdAt         DateTime            @default(now())
  editedAt          DateTime?
  deletedForEveryone Boolean            @default(false)
  deletedAt         DateTime?
  chat              Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender            User                @relation("senderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  reactions         ChatReaction[]
  readReceipts      ChatReadReceipt[]

  @@index([chatId, createdAt])
  @@index([senderId, createdAt])
}

model ChatReaction {
  id          String      @id @default(cuid())
  messageId   String
  userId      String
  emoji       String
  createdAt   DateTime    @default(now())
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId, createdAt])
}

model ChatReadReceipt {
  id          String      @id @default(cuid())
  messageId   String
  userId      String
  readAt      DateTime    @default(now())
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model UserPresence {
  id          String    @id @default(cuid())
  userId      String
  status      String    @default("ONLINE")
  socketId    String?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, lastSeenAt])
}


model CallLog {
  id                String    @id @default(cuid())
  callType          String
  status            String    @default("RINGING")
  chatId            String?
  initiatorId       String
  receiverId        String
  startedAt         DateTime?
  endedAt           DateTime?
  durationSec       Int?
  endReason         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  initiator         User      @relation("initiatedCalls", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver          User      @relation("receivedCalls", fields: [receiverId], references: [id], onDelete: Cascade)
  chat              Chat?     @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([initiatorId, createdAt])
  @@index([receiverId, createdAt])
  @@index([status, createdAt])
}


model UserCryptoKey {
  id          String   @id @default(cuid())
  userId      String   @unique
  publicKey   String
  algorithm   String   @default("RSA-OAEP-2048")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model ChatKeyEnvelope {
  id             String   @id @default(cuid())
  chatId         String
  userId         String
  encryptedKey   String
  keyVersion     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  chat           Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId, keyVersion])
  @@index([userId, updatedAt])
}

model AssistantMemory {
  id            String             @id @default(cuid())
  userId        String
  key           String
  value         String
  confidence    Float              @default(0.5)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, updatedAt])
}

model AssistantMessage {
  id            String             @id @default(cuid())
  userId        String
  role          String
  content       String
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
